# 环境变量模板 —— **不含任何真实密钥**（§10.2 M5-5）
#
#   cp .env.example .env   然后把占位值换成真的
#
# ⚠️ .env 已在 .gitignore 里。本模板**只能放占位值** ——
#    不要提交真密钥：本仓库历史上已经有过一次密钥进 git 的事故（U-1）。

LLM_TYPE=DEEPSEEK
EMBED_MODEL_TYPE=ALIYUN
VISION_MODEL_TYPE=ALIYUN
DEEPSEEK_API_KEY=<在此填入>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ALIYUN_ACCESS_KEY=<在此填入>
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen3-max
ALIYUN_EMBED_MODEL=qwen3.7-text-embedding
ALIYUN_VISION_MODEL=qwen3.7-plus
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
LLM_TEMPERATURE=0.3
RERANKER_DEVICE=cuda
RERANKER_MODEL_PATH=models/BAAI/bge-reranker-v2-m3
RERANKER_MODELSCOPE_NAME=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=10
RERANKER_MAX_LENGTH=512
MAX_FILE_SIZE=104857600
MAX_ZIP_SIZE=52428800
MAX_ZIP_TOTAL_SIZE=209715200
ZIP_MAX_WORKERS=4
SEMANTIC_MERGE_MODEL=paraphrase-multilingual-MiniLM-L12-v2
LOG_LEVEL=INFO
TEXT_CLEAN_ENABLED=true
MINERU_TOKEN=<在此填入>
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=campus_rag
PG_USER=campus_rag
PG_PASSWORD=<在此填入>
JWT_SECRET=<在此填入>
ADMIN_USERNAME=admin
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
